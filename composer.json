{
    "name": "schachbulle/contao-spielerregister-bundle",
    "type": "contao-bundle",
    "description": "Spielerregister des Deutschen Schachbundes mit Spielerdetails, Geburtstags-, Ehren-, Verstorbenen- und Titellisten.",
    "keywords": [
        "contao",
        "schach",
        "spieler",
        "register",
        "dsb"
    ],
    "homepage": "https://github.com/Samson1964/contao-spielerregister-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "contao/newsletter-bundle": "^4.13 || ^5.0",
        "menatwork/contao-multicolumnwizard-bundle": "^3.6 || ^4.0",
        "schachbulle/contao-helper-bundle": "^2.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.5"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoSpielerregisterBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoSpielerregisterBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoSpielerregisterBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-spielerregister-bundle/issues",
        "source": "https://github.com/Samson1964/contao-spielerregister-bundle"
    }
}
